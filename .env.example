# Copy to .env and adjust. Never commit .env.

# Shared Postgres (schemas: orders for order-api, agent for conversations/checkpoints)
DATABASE_URL=postgres://app:app@localhost:5432/desafio

# Order API
ORDER_API_PORT=3001
ORDER_API_URL=http://localhost:3001
# Service-to-service bearer token (order-api validates, agent sends)
ORDER_API_TOKEN=change-me-dev-token

# Agent
AGENT_PORT=3002
# fake = scripted responses, no API key needed | gemini = real model (Google AI Studio key)
LLM_PROVIDER=fake
GOOGLE_API_KEY=
LLM_UNDERSTAND_MODEL=gemini-3.5-flash-lite
LLM_COMPOSE_MODEL=gemini-3.5-flash-lite
FAKESTORE_URL=https://fakestoreapi.com

# Logging (pino): fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
